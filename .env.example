# Gemini AI Engine Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Supabase PostgreSQL & Authentication Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional Server-Only Service Role Key for elevated admin tasks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Meta OAuth Server Credentials (AI Marketing Agent)
META_CLIENT_ID=your-meta-app-id-here
META_CLIENT_SECRET=your-meta-app-secret-here

# Domain Hosting & Application Domain Configuration
APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_DOMAIN=codexys.site
HOSTING_A_RECORD_IP=76.76.21.21

# Domain Routing Feature Flag (Default: false)
DOMAIN_ROUTING_ENABLED=false

# Optional Vercel Custom Domain Provider Integration (Uncomment when deploying to Vercel production)
# VERCEL_TOKEN=your-vercel-api-token
# VERCEL_PROJECT_ID=your-vercel-project-id
# VERCEL_TEAM_ID=your-vercel-team-id

# ============================================================================
# Payment Gateway Configuration (Razorpay Primary & Stripe Secondary Architecture)
# ============================================================================
# Active Payment Provider: "mock" (default for test/staging), "razorpay" (recommended primary), or "stripe"
PAYMENT_PROVIDER=mock

# Live Payment Activation Guard (Default: false). Must be explicitly set to "true" to process real monetary charges.
PAYMENT_LIVE_ENABLED=false

# Allow mock payments on local development and staging (Default: true on non-production)
ALLOW_MOCK_PAYMENTS=true

# Primary Gateway: Razorpay (Optimized for India: UPI, Cards, Netbanking, e-Mandates, GST Invoicing)
# Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Dashboard -> Settings -> Webhooks (Webhook URL: https://your-domain.com/api/billing/webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Secondary Gateway: Stripe (International Cards & Fallback)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_yourStripePublishableKeyHere
STRIPE_SECRET_KEY=sk_test_yourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_yourStripeWebhookSecretHere

# ============================================================================
# Cloudflare Turnstile CAPTCHA Protection (Supabase Native Auth Integration)
# ============================================================================
# Public Site Key for frontend widget (Client-Side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
# Note: The Cloudflare Turnstile Secret Key must NEVER be placed in client-side code
# or NEXT_PUBLIC variables. Configure it directly in Supabase Project Dashboard under:
# Authentication -> Bot Protection -> Enable CAPTCHA -> Cloudflare Turnstile -> Secret Key


